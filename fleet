#!/usr/bin/env bash
# fleet — one-stop remote control for the cd108/cd106 lab fleet.
#
# Run this ON the lab server (cd108-server). It holds the inventory, the vault
# password and the deploy key, has wakeonlan, and sits on the lab L2 so
# Wake-on-LAN broadcasts actually reach the machines. From anywhere:
#
#     ssh daelt@cd108.tutu.eng.br
#     cd ~/cd108_ansible
#     ./fleet status all
#
# TARGET can be:
#   a host          cd108-05
#   a comma list    cd108-05,cd108-06
#   a group         cd108 | cd106 | labs | server
#   everything      all
#
# See MAINTENANCE.md for the human runbook and the once-before-you-leave checks.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

INV="${FLEET_INVENTORY:-inventory/hosts.yml}"
VAULT="${FLEET_VAULT:-$HOME/.vault_pass}"
KEY="${FLEET_SSH_KEY:-$HOME/.ssh/id_cd108_ansible}"
BCAST="${FLEET_BROADCAST:-103.0.31.255}"     # 103.0.0.0/19 directed broadcast
AUTH=(--vault-password-file "$VAULT" --become-password-file "$VAULT")
OVERLAY=(); [ -f "$HOME/ip-overlay.yml" ] && OVERLAY=(-e @"$HOME/ip-overlay.yml")

die(){ echo "fleet: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing '$1' — run this on cd108-server."; }

# Preflight: refuse to run anywhere but the server (where inventory+vault live).
[ -f "$INV" ]   || die "inventory '$INV' not found — run inside ~/cd108_ansible on cd108-server."
[ -f "$VAULT" ] || die "vault password '$VAULT' not found — run on cd108-server."

hosts_of(){ ansible "$1" -i "$INV" --list-hosts 2>/dev/null | sed '1d;s/^[[:space:]]*//'; }
fact_of(){ # fact_of HOST KEY  -> value from ansible-inventory (vaulted vars need the pass)
  ansible-inventory -i "$INV" --vault-password-file "$VAULT" --host "$1" 2>/dev/null \
    | python3 -c "import sys,json;print(json.load(sys.stdin).get('$2',''))" 2>/dev/null
}
confirm(){ # confirm ACTION COUNT   (skip with FLEET_YES=1)
  [ "${FLEET_YES:-0}" = 1 ] && return 0
  local a; read -r -p "About to $1 $2 machine(s). Type 'yes' to proceed: " a
  [ "$a" = yes ] || die "aborted."
}

usage(){
  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'EOF'
Commands:
  status   TARGET     ping every host (UP = reachable over SSH)
  last-seen [FILTER]  when each machine last phoned home (dead-machine detector)
  wake     TARGET     send Wake-on-LAN magic packets
  reboot   TARGET     reboot and wait for each host to return
  shutdown TARGET     graceful power-off (bring back with 'wake')
  update   TARGET     apt update + full-upgrade (VS Code included)
  boot     TARGET     show UEFI BootOrder + any Windows entry (diagnostics)
  efifix   TARGET     re-apply the phantom-Windows EFI fix (site.yml --tags efi)
  converge TARGET     full site.yml converge
  restore-homes TARGET   DESTRUCTIVE: reset course homes to the server golden
  macs     TARGET     list each host's MAC
  ssh      HOST       open an interactive shell on one machine

Examples:
  ./fleet status all
  ./fleet wake cd108-05
  ./fleet reboot cd108              # the whole cd108 room
  ./fleet shutdown all
  ./fleet update labs
  FLEET_YES=1 ./fleet reboot cd108-11,cd108-13    # skip the prompt

Env overrides: FLEET_BROADCAST, FLEET_VAULT, FLEET_INVENTORY, FLEET_SSH_KEY, FLEET_YES
EOF
}

cmd="${1:-}"; target="${2:-}"
case "$cmd" in ""|-h|--help|help) usage; exit 0;; esac

# last-seen takes an optional filter, not a required target — handle it first.
if [ "$cmd" = last-seen ] || [ "$cmd" = lastseen ]; then
  exec python3 scripts/fleet-lastseen.py "${@:2}"
fi

[ -n "$target" ] || die "need a TARGET (host, group, or 'all'). Try ./fleet --help"

case "$cmd" in
  status)
    ansible "$target" -i "$INV" -m ping "${AUTH[@]}" -o 2>/dev/null \
      | sed -E 's/ \| SUCCESS.*/  UP/; s/ \| UNREACHABLE.*/  DOWN/; s/ \|.*FAILED.*/  ERROR/' \
      | sort ;;

  macs)
    for h in $(hosts_of "$target"); do printf '%-14s %s\n' "$h" "$(fact_of "$h" mac)"; done ;;

  wake)
    need wakeonlan; n=0
    for h in $(hosts_of "$target"); do
      m="$(fact_of "$h" mac)"; [ -n "$m" ] || { echo "skip $h (no MAC in inventory)"; continue; }
      wakeonlan -i "$BCAST" "$m" >/dev/null && echo "woke  $h  ($m)"; n=$((n+1))
    done
    echo "-- sent $n magic packet(s) via $BCAST; give them 1-2 min then: ./fleet status $target" ;;

  reboot)
    mapfile -t hs < <(hosts_of "$target"); confirm reboot "${#hs[@]}"
    ansible "$target" -i "$INV" -b -m reboot -a "reboot_timeout=300" "${AUTH[@]}" ;;

  shutdown)
    mapfile -t hs < <(hosts_of "$target"); confirm "shut down" "${#hs[@]}"
    # Schedule the poweroff a few seconds out via a transient timer so the SSH
    # command returns cleanly first — otherwise the box dies mid-reply and
    # ansible reports a misleading UNREACHABLE.
    ansible "$target" -i "$INV" -b -m shell \
      -a "systemd-run -q --collect --on-active=3s systemctl poweroff" "${AUTH[@]}"
    echo "-- power-off scheduled (~3s); bring them back with: ./fleet wake $target" ;;

  update)
    # Patch only the hosts that are actually up — an offline machine would
    # otherwise print a scary red UNREACHABLE block. We report the skipped ones
    # plainly; any FAILED that survives here is a *real* apt problem worth seeing.
    mapfile -t want < <(hosts_of "$target" | sort)
    mapfile -t up   < <(ansible "$target" -i "$INV" -m ping "${AUTH[@]}" -o 2>/dev/null \
                        | sed -n 's/ | SUCCESS.*//p' | sort)
    if [ "${#up[@]}" -eq 0 ]; then
      echo "fleet update: no reachable hosts in '$target' (all offline?). Try: ./fleet wake $target"
      exit 0
    fi
    offline="$(comm -23 <(printf '%s\n' "${want[@]}") <(printf '%s\n' "${up[@]}") | paste -sd, -)"
    [ -n "$offline" ] && echo "-- skipping offline (wake them first): $offline"
    limit="$(IFS=,; echo "${up[*]}")"
    echo "-- updating ${#up[@]} reachable host(s): $limit"
    ansible "$limit" -i "$INV" -b -m apt \
      -a "update_cache=yes cache_valid_time=0 upgrade=dist" "${AUTH[@]}" ;;

  boot)
    ansible "$target" -i "$INV" -b -m shell -a \
      'efibootmgr | grep -E "^BootOrder|Windows Boot Manager" | tr "\n" "  "; echo' \
      "${AUTH[@]}" -o 2>/dev/null | sed -E 's/ \| CHANGED \| rc=0 \| \(stdout\) /  /' | sort ;;

  efifix)
    ansible-playbook site.yml -i "$INV" --tags efi --limit "$target" "${OVERLAY[@]}" "${AUTH[@]}" ;;

  converge)
    ansible-playbook site.yml -i "$INV" --limit "$target" "${OVERLAY[@]}" "${AUTH[@]}" ;;

  restore-homes)
    mapfile -t hs < <(hosts_of "$target")
    echo "!! DESTRUCTIVE: wipes local homes back to the server golden (students lose"
    echo "!! anything not uploaded to the cloud). Target: ${#hs[@]} machine(s)."
    confirm "reset the homes of" "${#hs[@]}"
    ansible-playbook reset-homes.yml -i "$INV" --limit "$target" "${OVERLAY[@]}" "${AUTH[@]}" ;;

  ssh)
    # ansible_host/ansible_user are runtime Jinja (beacon IP, admin_user) that
    # ansible-inventory won't render, so resolve the address through ansible itself.
    usr="${FLEET_SSH_USER:-daelt}"
    ip="$(ansible "$target" -i "$INV" "${AUTH[@]}" -m debug -a var=ansible_host 2>/dev/null \
          | sed -n 's/.*"ansible_host": "\(.*\)".*/\1/p' | head -1)"
    [ -n "$ip" ] || ip="$target"
    echo "-- ssh $usr@$ip" >&2
    exec ssh -i "$KEY" "$usr@$ip" ;;

  *) die "unknown command '$cmd' (try ./fleet --help)";;
esac
